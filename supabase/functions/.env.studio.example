# Public browser origin allowed to call the Studio functions.
STUDIO_ALLOWED_ORIGIN=https://timelessapp.ai,http://localhost:3000,http://127.0.0.1:8123

# Default media adapter (Kie today). studio-create-generation routes through
# the regulation aggregator; this URL is used for provider=kie unless a more
# specific STUDIO_PROVIDER_KIE_URL is set.
STUDIO_PROVIDER_SUBMIT_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/studio-kie-adapter
STUDIO_PROVIDER_API_KEY=replace-with-a-long-random-server-secret
# Optional per-vendor adapter URLs. Unregistered vendors fail closed unless set.
# STUDIO_PROVIDER_KIE_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/studio-kie-adapter
# STUDIO_PROVIDER_FAL_URL=https://example.com/studio-fal-adapter

# Authenticates the daily retention worker. Store the same random value in
# Supabase Edge Function secrets and Vault as studio_cleanup_secret.
STUDIO_CLEANUP_SECRET=replace-with-a-different-long-random-secret

# Kie is only read by the server-side adapter. Never use this in Flutter,
# JavaScript, a checked-in .env file, or a browser request.
KIE_API_KEY=replace-with-your-kie-server-key

# Shared only by Supabase Functions and the provider adapter. The adapter signs
# the exact webhook request body with HMAC-SHA256 and sends the lowercase hex
# digest in x-studio-signature.
STUDIO_PROVIDER_WEBHOOK_SECRET=replace-with-a-different-long-random-secret

# Supabase injects these in hosted Edge Functions. They are listed only to make
# local development requirements explicit; never expose the service-role key.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Stripe hosted Checkout. The webhook secret is specific to the endpoint at
# /functions/v1/studio-stripe-webhook.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STUDIO_WEB_URL=https://timelessapp.ai/studio
